# dependencies and package-manager state
node_modules/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*
# The Yarn config must be committed (nodeLinker: node-modules; without it CI falls back to PnP and fails), but some
# global git ignores list it, so re-include it explicitly.
!.yarnrc.yml

# build and report output (the caps tool trusts .gitignore inside git, so every output dir must be listed)
dist/
build/
coverage/
reports/
playwright-report/
test-results/
.stryker-tmp/
.vitest/
# Qodana input (the coverage-lcov artifact is downloaded into .qodana/code-coverage) and local results (E20-S08)
.qodana/
*.tsbuildinfo

# offline Semgrep rules: the Semgrep Rules License forbids redistribution
/rules/

# local state (the development database port chosen by `yarn db:up`)
.local/

# secrets and local configuration (secrets/ is what scripts/init-secrets.sh creates for the compose stack, E19-S04)
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# editor, OS and local tool state
.idea/
.vscode/
.gitnexus/
.claude/settings.local.json
*.log
.DS_Store
