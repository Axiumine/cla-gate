# Migrations are checksummed (src/server/adapters/db/migrator.ts): a CRLF checkout on Windows must not change the hash.
migrations/*.sql text eol=lf

# Visual baselines are PNG files written only by the pinned container: never diffed, merged or converted as text.
e2e/__screenshots__/** binary

# The stored exports end their lines with CRLF, as the CSV of RFC 4180 does: a checkout must not turn them into LF (E16-S03).
src/server/services/export/csv-snapshots/** -text
