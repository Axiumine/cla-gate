# Environment of the CLA Platform. `sh scripts/init-secrets.sh` copies this file to `.env` for the compose stack
# (docker-compose.yml), which reads `.env` by itself and passes the settings below to the app; the server itself reads only
# real environment variables and no dotenv file. An empty value counts as unset. Secrets stay empty here: the compose stack
# keeps them in `secrets/` and any other deployment in its secret manager, never in this file. Every secret below also has a
# `<NAME>_FILE` variant that names a file holding the value (a Docker secret, /run/secrets/<name>); set the value or the
# file, not both. Every variable is explained in docs/configuration.md.

# The compose stack only (E19-S04): where the app's port is published on the host, and the subnet of the stack's own
# network. BIND_ADDRESS stays 127.0.0.1 behind a reverse proxy; the proxy of the `tls` profile is the way in from outside.
BIND_ADDRESS=127.0.0.1
# Must contain the proxy of the stack and the gateway of the network, and TRUST_PROXY below must name it: change them together.
EDGE_SUBNET=172.30.30.0/24
# The `tls` profile (E19-S05), the reverse proxy with automatic TLS: `docker compose --profile tls up -d`. PUBLIC_BASE_URL below
# must be the https origin of this server, and its DNS name must point here. ACME_EMAIL is the address Let's Encrypt sends
# expiry notices to; empty is allowed.
ACME_EMAIL=
# Where the proxy listens on the host. These are the public ports 80 and 443 of the deployment; change them only to run a
# second stack on one machine or a test. CADDY_BIND_ADDRESS empty means every interface; 127.0.0.1 keeps the proxy local.
CADDY_BIND_ADDRESS=
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# The image sets NODE_ENV=production and HOST=0.0.0.0, so the compose stack ignores these two lines.
NODE_ENV=development
HOST=127.0.0.1
# The port the server listens on. In the compose stack the app always listens on 3000 inside its container, and this is the
# host port it is published on (together with BIND_ADDRESS above).
PORT=3000
LOG_LEVEL=info
# postgres:// connection string of the unprivileged runtime role cla_app (a secret).
DATABASE_URL=
# Owner connection used by `yarn db:migrate` only; required in production (a secret).
MIGRATION_DATABASE_URL=
# Origin the public reaches the app on, no path; https:// and required in production.
PUBLIC_BASE_URL=
# true, false, a hop count or a comma separated list of trusted proxy IPs and CIDRs. The value below trusts the compose
# stack's own network (EDGE_SUBNET above), so the proxy of the stack and a proxy on the host are trusted and nothing else is;
# outside compose, `false` is the safe default.
TRUST_PROXY=172.30.30.0/24
# Directory of the built single-page app (yarn build writes dist/web, the default); served unless NODE_ENV=development.
# The image keeps it where the server expects it, so the compose stack ignores this line.
WEB_ROOT=
# Where the corresponding source of the running version is (AGPL section 13): the repository the footer links to, and the
# 40 character commit it was built from (empty or unknown: not known, and the footer links to the repository itself).
SOURCE_URL=https://github.com/Axiumine/cla-gate
SOURCE_COMMIT=

# Jobs (E07). WORKER_CONCURRENCY is how many jobs of one queue run at once in this process (1 to 32). SWEEP_INTERVAL_MINUTES is
# the time between two reconciliation sweeps: 5, 10, 15, 20, 30 or 60, or 0 for none.
WORKER_CONCURRENCY=4
SWEEP_INTERVAL_MINUTES=30

# Login and sessions (E10-S01). Production requires SESSION_SECRET (at least 32 characters, a secret),
# GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET (a secret); the login routes exist only when all three are set.
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Seconds a session may sit idle (default 28800, 8 hours) and live at most (default 604800, 7 days). Each at least
# 300, idle never above absolute.
SESSION_IDLE_SECONDS=28800
SESSION_ABSOLUTE_SECONDS=604800

# The GitHub App. Production needs the App id, the private key (PEM, a secret) and the webhook secret together with the
# client id and secret above, or none of the five: with none, the server starts in setup mode and needs SETUP_TOKEN.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# The key kept during a rotation (a secret); leave empty otherwise.
GITHUB_APP_PRIVATE_KEY_PREVIOUS=
# Comma separated numeric GitHub account ids served besides the account that owns the App; empty means the owner only.
GITHUB_ALLOWED_ACCOUNT_IDS=
# Comma separated numeric GitHub user ids of the people who operate the instance and may list its installations (at most 20).
# Empty means the account that owns the App, if it is a user; nobody if it is an organisation.
OPERATOR_GITHUB_IDS=
# Signs every webhook delivery (a secret, at least 16 characters).
GITHUB_WEBHOOK_SECRET=
# The webhook secret kept during a rotation (a secret, at least 16 characters); leave empty otherwise.
GITHUB_WEBHOOK_SECRET_PREVIOUS=

# The one-time token that unlocks the first-run setup (a secret, at least 32 characters). Required while no GitHub App is
# configured; ignored, with a warning, once one is.
SETUP_TOKEN=

# Whether signing stores the IP address and the user agent of the request (E13-S05): exactly true or false, default false.
# They are personal data: switch it on only with a documented legitimate interest, and see the retention below.
RECORD_NETWORK_METADATA=false
# Days the optional network metadata (IP address and user agent, stored only when RECORD_NETWORK_METADATA is true) is
# kept before a daily job removes it (E16-S05). A whole number from 1 to 90, default 30. It applies whether or not
# recording is still on.
NETWORK_METADATA_RETENTION_DAYS=30
