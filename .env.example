# Environment of the CLA Platform server. Copy to `.env` for a compose stack; the server itself reads only real
# environment variables and no dotenv file. An empty value counts as unset. Secrets stay empty here: set them in your
# secret manager, never in this file. Every variable is explained in docs/configuration.md.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# postgres:// connection string of the unprivileged runtime role cla_app (a secret).
DATABASE_URL=
# Owner connection used by `yarn db:migrate` only; required in production (a secret).
MIGRATION_DATABASE_URL=
# Origin the public reaches the app on, no path; https:// and required in production.
PUBLIC_BASE_URL=
# true, false, a hop count or a comma separated list of trusted proxy IPs and CIDRs.
TRUST_PROXY=false

# Login and sessions (E10-S01). Production requires SESSION_SECRET (at least 32 characters, a secret),
# GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET (a secret); the login routes exist only when all three are set.
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Seconds a session may sit idle (default 28800, 8 hours) and live at most (default 604800, 7 days). Each at least
# 300, idle never above absolute.
SESSION_IDLE_SECONDS=28800
SESSION_ABSOLUTE_SECONDS=604800

# The GitHub App. The id, the private key (PEM, a secret) and the webhook secret are required in production.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# The key kept during a rotation (a secret); leave empty otherwise.
GITHUB_APP_PRIVATE_KEY_PREVIOUS=
# Comma separated numeric GitHub account ids served besides the account that owns the App; empty means the owner only.
GITHUB_ALLOWED_ACCOUNT_IDS=
# Comma separated numeric GitHub user ids of the people who operate the instance and may list its installations (at most 20).
# Empty means the account that owns the App, if it is a user; nobody if it is an organisation.
OPERATOR_GITHUB_IDS=
# Signs every webhook delivery (a secret, at least 16 characters).
GITHUB_WEBHOOK_SECRET=
# The webhook secret kept during a rotation (a secret, at least 16 characters); leave empty otherwise.
GITHUB_WEBHOOK_SECRET_PREVIOUS=
