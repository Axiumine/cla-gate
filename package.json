{
  "name": "cla-gate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "postinstall": "node scripts/dev/install-hooks.ts",
    "dev": "node scripts/dev/db.ts run app -- node scripts/dev/dev.ts",
    "build": "tsc -b && vite build",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -b",
    "type-coverage": "type-coverage --strict --at-least 100 -p tsconfig.server.json && type-coverage --strict --at-least 100 -p tsconfig.server.test.json && type-coverage --strict --at-least 100 -p tsconfig.web.json && type-coverage --strict --at-least 100 -p tsconfig.scripts.json && type-coverage --strict --at-least 100 -p tsconfig.e2e.json && type-coverage --strict --at-least 100 -p tsconfig.node.json",
    "lint": "yarn lint:biome && yarn lint:eslint && yarn lint:hatches",
    "lint:biome": "biome ci --error-on-warnings .",
    "lint:eslint": "eslint . --max-warnings 0 --no-warn-ignored",
    "lint:hatches": "node scripts/check-escape-hatches.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "CI=1 vitest run --coverage",
    "knip": "knip && knip --production --strict",
    "fta": "fta . --config-path fta.json",
    "caps": "node scripts/check-code-caps.ts",
    "mutate": "node scripts/mutation-gate/mutate.ts --all",
    "mutate:shard": "node scripts/mutation-gate/mutate.ts",
    "mutate:scripts": "STRYKER_SCOPE=scripts stryker run --incremental",
    "mutate:check-incremental": "node scripts/mutation-gate/check-incremental.ts",
    "mutate:decide": "node scripts/mutation-gate/decide-skip.ts",
    "semgrep": "semgrep scan --config p/typescript --config p/javascript --config p/react --config p/nodejsscan --config p/secrets --error --metrics off --disable-version-check",
    "semgrep:rules": "node scripts/fetch-semgrep-rules.ts",
    "semgrep:offline": "semgrep scan --config rules/ --error --metrics off --disable-version-check",
    "trivy": "trivy fs --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 . && trivy fs --scanners secret,misconfig --exit-code 1 .",
    "trivy:dev": "trivy fs --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --include-dev-deps .",
    "trivy:secrets": "trivy fs --scanners secret --exit-code 1 .",
    "e2e": "playwright test",
    "e2e:update": "docker run --rm --init --ipc=host --network host --user \"$(id -u):$(id -g)\" --volume \"$PWD:/work\" --workdir /work --env E2E_CONTAINER=1 --env HOME=/tmp --env SKIP_YARN_COREPACK_CHECK=1 --env CI --env DATABASE_URL mcr.microsoft.com/playwright:v1.64.1-noble@sha256:2f05f8a734509a7b3f26a912639488ee08f58a7b292d14d62271bcff9038768f yarn e2e --update-snapshots",
    "leaks": "node tests/leaks/run.ts",
    "leaks:control": "node tests/leaks/control/run.ts",
    "ci:port": "node scripts/ci/free-port.ts",
    "ci:postgres": "node scripts/ci/postgres.ts",
    "ci:e2e": "node scripts/ci/e2e.ts",
    "ci:runners": "node scripts/ci/check-runners.ts",
    "db:up": "node scripts/dev/db.ts up",
    "db:url": "node scripts/dev/db.ts url",
    "db:down": "node scripts/dev/db.ts down",
    "db:migrate": "node scripts/dev/db.ts run owner -- node src/server/migrate.ts",
    "gate": "lefthook run pre-push --all-files"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@opentelemetry/api": "1.9.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.3",
    "fastify-type-provider-zod": "^7.0.0",
    "hast-util-to-html": "9.0.6",
    "kysely": "^0.29.7",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@electric-sql/pglite": "0.5.14",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@memlab/api": "2.0.6",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fta-cli": "3.1.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "memlab": "2.0.6",
    "msw": "^3.0.3",
    "parse5": "^8.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.3",
    "type-coverage": "^2.31.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
