{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["semgrep", "trivy"],
  "ignoreDependencies": ["memlab"],
  "entry": [
    "scripts/*.ts!",
    "scripts/ci/*.ts",
    "scripts/dev/*.ts",
    "src/server/main.ts!",
    "src/server/migrate.ts!",
    "src/server/domain/evaluation/index.ts!",
    "src/shared/pr-evaluation-details.ts!",
    "tests/leaks/scenarios/*.ts",
    "tests/leaks/control/*.ts",
    "src/server/domain/eligibility.ts!",
    "src/server/adapters/http/tenant-access.ts!",
    "src/server/adapters/db/tenant-scope.ts!",
    "src/server/adapters/http/tenant-resolvers.ts!",
    "src/server/services/installation-store.ts!",
    "src/server/services/revoke-user-sessions.ts!"
  ],
  "project": [
    "scripts/**/*.ts!",
    "!scripts/code-caps/test-support.ts!",
    "!scripts/escape-hatches/eslint-config.ts!",
    "!scripts/ci/**!",
    "!scripts/ci-contract/**!",
    "!scripts/dev/**!",
    "!scripts/e2e/**!",
    "!scripts/leaks/**!",
    "!scripts/mutation-gate/**!",
    "!scripts/qodana-gate/**!",
    "!scripts/semgrep-rules/**!",
    "!scripts/trivy-gate/**!",
    "src/**/*.ts!",
    "!src/**/test-support.ts!",
    "!src/server/adapters/db/pglite.ts!",
    "!src/server/adapters/db/pglite/**!",
    "!src/server/adapters/db/global-setup.ts!",
    "*.{ts,mjs}",
    "types/**/*.d.ts"
  ]
}
