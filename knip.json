    "!scripts/ci/**!",
    "!scripts/ci-contract/**!",
    "!scripts/dev/**!",
    "!scripts/e2e/**!",
    "!scripts/leaks/**!",
    "!scripts/mutation-gate/**!",
    "!scripts/qodana-gate/**!",
    "!scripts/semgrep-rules/**!",
    "!scripts/trivy-gate/**!",
    "!scripts/web/eslint-config.ts!",
    "!scripts/web/test-support.ts!",
    "!scripts/web/theme-init-build.ts!",
    "src/**/*.{ts,tsx}!",
    "src/**/*.css",
    "!src/**/test-support.ts!",
    "!src/shared/hostile-names.ts!",
    "!src/web/test-support/**!",
    "!src/server/adapters/db/pglite.ts!",
    "!src/server/adapters/db/pglite/**!",
