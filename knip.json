{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["semgrep", "trivy"],
  "ignoreDependencies": ["memlab"],
  "entry": [
    "scripts/*.ts!",
    "scripts/ci/*.ts",
    "scripts/dev/*.ts",
    "src/server/main.ts!",
    "src/server/migrate.ts!",
    "src/web/i18n/index.ts!",
    "src/web/api/index.ts!",
    "src/web/auth/index.ts!",
    "src/web/theme/theme-init.ts!",
    "src/web/states/index.ts!",
    "src/web/ui/index.ts!",
    "src/web/styles/app.css",
    "src/server/domain/evaluation/index.ts!",
    "src/shared/pr-evaluation-details.ts!",
    "src/shared/hostile-names.ts!",
    "tests/leaks/scenarios/*.ts",
    "tests/leaks/control/*.ts",
    "src/server/domain/eligibility.ts!",
    "src/server/adapters/http/tenant-access.ts!",
    "src/server/adapters/db/tenant-scope.ts!",
    "src/server/adapters/http/tenant-resolvers.ts!",
