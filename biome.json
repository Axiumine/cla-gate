{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "markdown": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 10 } },
        "useLiteralKeys": "off"
      }
    },
    "domains": { "playwright": "none", "react": "none" }
  },
  "overrides": [
    { "includes": ["e2e/**"], "linter": { "domains": { "playwright": "recommended" } } },
    {
      "includes": ["src/web/**"],
      "linter": {
        "domains": { "react": "recommended" },
        "rules": { "a11y": "error", "security": { "noDangerouslySetInnerHtml": "error" } }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
